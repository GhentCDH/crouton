{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@ghentcdh/crouton"],
    "noUncheckedSideEffectImports": false,
    "types": ["node"],
    "paths": {
      "@crouton/status": ["./libs/status/src/index.ts"],
      "@crouton/i18n": ["./libs/i18n/src/index.ts"]
    }
  }
}
