{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@ghentcdh/crouton"],
    "noUncheckedSideEffectImports": false,
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "paths": {
      "@ghentcdh/crouton-frontend-core": [
        "./packages/crouton-frontend-core/src/index.ts"
      ]
    }
  }
}
