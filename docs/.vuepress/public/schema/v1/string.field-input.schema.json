{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "label": {
      "description": "Override the field label",
      "type": "string"
    },
    "hideLabel": {
      "description": "Hide the label",
      "type": "boolean"
    },
    "placeholder": {
      "type": "string"
    },
    "readonly": {
      "type": "boolean"
    },
    "colspan": {
      "type": "number"
    },
    "width": {
      "type": "string"
    },
    "styles": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "customRender": {
      "type": "string"
    },
    "unique": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caseInsensitive": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "enabled"
      ]
    }
  },
  "additionalProperties": {},
  "$id": "https://ghentcdh.github.io/crouton/schema/v1/string.field-input.schema.json",
  "title": "Crouton fieldInput options: string"
}
