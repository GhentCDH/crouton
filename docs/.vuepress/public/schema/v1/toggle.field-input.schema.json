{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "label": {
      "description": "Override the field label",
      "type": "string"
    },
    "hideLabel": {
      "description": "Hide the label",
      "type": "boolean"
    },
    "placeholder": {
      "type": "string"
    },
    "readonly": {
      "type": "boolean"
    },
    "colspan": {
      "type": "number"
    },
    "width": {
      "type": "string"
    },
    "styles": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "customRender": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {}
    },
    "values": {
      "type": "array",
      "items": {}
    },
    "labelKey": {
      "type": "string"
    },
    "valueKey": {
      "type": "string"
    },
    "storeValue": {
      "description": "Store option[valueKey] instead of the whole object",
      "type": "boolean"
    },
    "clearable": {
      "default": true,
      "description": "Clicking active button clears the value",
      "type": "boolean"
    },
    "color": {
      "default": "primary",
      "description": "Btn color for the active button",
      "type": "string"
    },
    "size": {
      "default": "sm",
      "description": "Btn size",
      "type": "string"
    }
  },
  "additionalProperties": {},
  "$id": "https://ghentcdh.github.io/crouton/schema/v1/toggle.field-input.schema.json",
  "title": "Crouton fieldInput options: toggle"
}
