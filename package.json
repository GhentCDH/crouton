{
  "name": "@ghentcdh/crouton-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "knip": "knip --no-progress --no-exit-code",
    "knip:strict": "knip --no-progress --include files,exports,dependencies",
    "e2e": "NX_TUI=false nx run book-collection-e2e:e2e",
    "e2e:update-snapshots": "NX_TUI=false nx run book-collection-e2e:e2e:update-snapshots",
    "lint": "nx run-many -t lint",
    "format": "prettier --write \"packages/**/*.{ts,js,json,md}\"",
    "docs:build": "nx run docs:build",
    "docs:serve": "nx run docs:serve",
    "prepare": "husky",
    "typecheck": "nx run-many -t typecheck",
    "dev": "nx run-many -t dev --parallel"
  },
  "private": true,
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@ghentcdh/ui": "^3.0.6",
    "@jsonforms/core": "^3.8.0",
    "@nx/eslint": "24.0.5",
    "@nx/eslint-plugin": "24.0.5",
    "@nx/js": "24.0.5",
    "@nx/vite": "24.0.5",
    "@nx/vitest": "24.0.5",
    "@nx/vue": "24.0.5",
    "@playwright/test": "^1.65.0",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.22",
    "@swc/helpers": "0.5.24",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vuepress/bundler-vite": "2.0.0-rc.26",
    "axios": "^1.20.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-vue": "^10.12.0",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^3.3.0",
    "knip": "^6.44.2",
    "mermaid": "^12.3.0",
    "nx": "24.0.5",
    "playwright": "^1.65.0",
    "prettier": "^3.9.9",
    "sass": "^1.108.1",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.6",
    "vite-plugin-dts": "5.1.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-router": "^5.4.0",
    "vue-tsc": "3.3.14",
    "vuepress": "2.0.0-rc.26",
    "vuepress-theme-hope": "2.0.0-rc.110",
    "zod": "^4.6.5"
  },
  "workspaces": [
    "packages/*",
    "libs/*",
    "examples/book-collection/apps/*",
    "examples/book-collection/apps/generated/default/types"
  ],
  "dependencies": {
    "@ghentcdh/create-crouton": "link:packages/create-crouton",
    "@heroicons/vue": "^2.2.0",
    "jose": "^6.2.16"
  }
}
