{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "name": "user",
  "model": "User",
  "title": "Users",
  "columns": {
    "id": { "idField": true, "hiddenInForm": true },
    "name": { "searchable": true, "filterable": true, "sortable": true },
    "email": {
      "searchable": true,
      "filterable": true,
      "sortable": true,
      "unique": true
    }
  }
}
