{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "name": "author",
  "model": "Author",
  "title": "Authors",
  "columns": {
    "id": { "idField": true, "hiddenInForm": true },
    "name": { "searchable": true, "filterable": true, "sortable": true },
    "bio": { "fieldInput": { "type": "textarea" }, "hiddenInTable": true },
    "books": {
      "label": "Books",
      "hiddenInTable": false,
      "hiddenInForm": false,
      "fieldInput": {
        "foreignKey": "authorId",
        "format": "relation",
        "relationType": "oneToMany",
        "resource": "../book/resource.json",
        "options": {
          "type": "table",
          "displayKey": "title"
        }
      }
    }
  },
  "include": ["books"]
}
