{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "name": "author",
  "title": "Authors",
  "columns": {
    "id": {
      "idField": true,
      "hiddenInForm": true
    },
    "name": {},
    "bio": {
      "fieldInput": {
        "type": "textarea"
      },
      "hiddenInTable": true
    },
    "notes": {
      "fieldInput": {
        "type": "markdown"
      },
      "hiddenInTable": true
    },
    "books": {
      "label": "Books",
      "hiddenInTable": false,
      "hiddenInForm": false,
      "fieldInput": {
        "foreignKey": "authorId",
        "format": "relation",
        "relationType": "oneToMany",
        "resource": "../book/resource.json",
        "options": {
          "type": "table",
          "displayKey": "title"
        }
      }
    }
  },
  "operations": {
    "findAll": {
      "search": [
        "name"
      ],
      "include": [
        "books"
      ]
    },
    "findOne": {
      "include": [
        "books"
      ]
    }
  },
  "layout": {
    "form": {
      "type": "vertical",
      "items": [
        "name",
        {
          "type": "horizontal",
          "title": "Details",
          "items": ["bio", "notes"]
        }
      ]
    },
    "table": {
      "filterFields": [
        "name"
      ]
    }
  },
  "source": {
    "model": "Author"
  }
}
