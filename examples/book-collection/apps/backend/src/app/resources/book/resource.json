{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "name": "book",
  "model": "Book",
  "title": "Books",
  "columns": {
    "id": { "idField": true, "hiddenInForm": true },
    "title": { "sortable": true },
    "isbn": { "sortable": true },
    "publishedYear": {
      "sortable": true
    },
    "status": {
      "displayKey": "label",
      "enum": "bookStatus",
      "fieldInput": {
        "type": "select",
        "options": {
          "clearable": false,
          "storeValue": true
        }
      }
    },
    "summary": { "fieldInput": { "type": "textarea" }, "hiddenInTable": true },
    "rating": {
      "fieldInput": {
        "type": "custom",
        "options": {
          "customComponent": "rating"
        }
      }
    },
    "authorId": {
      "hiddenInTable": true,
      "hiddenInView": true,
      "label": "Author",
      "displayKey": "name",
      "fieldInput": {
        "type": "autocomplete",
        "options": {
          "resource": "/author/schemas",
          "labelKey": "name",
          "valueKey": "id",
          "storeValue": true
        }
      }
    },
    "author": {
      "label": "Author",
      "hiddenInTable": false,
      "hiddenInForm": true,
      "sortable": true,
      "displayKey": "name",
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "options": {
          "displayKey": "name"
        }
      }
    },
    "categories": {
      "label": "Categories",
      "hiddenInTable": true,
      "fieldInput": {
        "format": "relation",
        "resource": "../category/resource.json",
        "relationType": "manyToMany",
        "options": {
          "displayKey": "name"
        }
      }
    }
  },
  "operations": {
    "findAll": { "search": ["title", "author"], "include": ["author", "categories"] },
    "findOne": { "include": ["author", "categories"] }
  },
  "layout": {
    "form": {
      "type": "grid",
      "columns": 12,
      "items": [
        { "id": "title", "colspan": 8 },
        { "id": "isbn", "colspan": 4 },
        { "id": "publishedYear", "colspan": 6 },
        { "id": "status", "colspan": 6 },
        { "id": "summary", "colspan": 12, "rowspan": 2 },
        { "id": "rating", "colspan": 6 },
        { "id": "authorId", "colspan": 6 },
        {
          "type": "collapse",
          "title": "Categories",
          "items": ["categories"]
        }
      ]
    },
    "view": {
      "type": "grid",
      "columns": 12,
      "items": [
        { "id": "title", "colspan": 8 },
        { "id": "isbn", "colspan": 4 },
        { "id": "publishedYear", "colspan": 6 },
        { "id": "status", "colspan": 6 },
        { "id": "summary", "colspan": 12 },
        { "id": "rating", "colspan": 6 },
        { "id": "author", "colspan": 6 },
        {
          "type": "group",
          "title": "Categories",
          "items": ["categories"]
        }
      ]
    },
    "table": {
      "type": "grid",
      "columns": 12,
      "items": [
        { "component": "CreateByIsbn" },
        {
          "type": "table",
          "filterFields": ["title", "status", "author"],
          "items": [
            "title",
            "author",
            "isbn",
            "publishedYear",
            "status",
            "rating"
          ],
          "tableActions": [
            {
              "id": "searchOpenLibrary",
              "label": "Search Open Library",
              "type": "link",
              "href": "https://openlibrary.org/search"
            }
          ],
          "rowActions": [
            {
              "id": "openOnOpenLibrary",
              "label": "Open on Open Library",
              "type": "link",
              "href": "https://openlibrary.org/isbn/{isbn}",
              "condition": { "field": "isbn", "op": "exists" }
            }
          ]
        }
      ]
    }
  }
}
