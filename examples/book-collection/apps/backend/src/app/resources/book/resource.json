{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "name": "book",
  "model": "Book",
  "title": "Books",
  "columns": {
    "id": { "idField": true, "hiddenInForm": true },
    "title": { "searchable": true, "filterable": true, "sortable": true },
    "isbn": { "sortable": true },
    "publishedYear": {
      "sortable": true
    },
    "status": {
      "displayKey": "label",
      "enum": "bookStatus",
      "filterable": true,
      "fieldInput": {
        "type": "select",
        "options": {
          "clearable": false,
          "storeValue": true
        }
      }
    },
    "summary": { "fieldInput": { "type": "textarea" }, "hiddenInTable": true },
    "rating": {
      "hiddenInTable": true,
      "fieldInput": {
        "type": "custom",
        "options": {
          "customComponent": "rating"
        }
      }
    },
    "authorId": {
      "hiddenInTable": true,
      "hiddenInView": true,
      "label": "Author",
      "displayKey": "name",
      "fieldInput": {
        "type": "autocomplete",
        "options": {
          "resource": "/author/schemas",
          "labelKey": "name",
          "valueKey": "id",
          "storeValue": true
        }
      }
    },
    "author": {
      "label": "Author",
      "hiddenInTable": false,
      "hiddenInForm": true,
      "filterable": true,
      "sortable": true,
      "searchable": true,
      "displayKey": "name",
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "options": {
          "displayKey": "name"
        }
      }
    },
    "categories": {
      "label": "Categories",
      "hiddenInTable": true,
      "fieldInput": {
        "format": "relation",
        "resource": "../category/resource.json",
        "relationType": "manyToMany",
        "options": {
          "displayKey": "name"
        }
      }
    }
  },
  "include": ["author", "categories"],
  "layout": {
    "form": {
      "type": "grid",
      "columns": 12,
      "controls": [
        { "id": "title", "colspan": 8 },
        { "id": "isbn", "colspan": 4 },
        { "id": "publishedYear", "colspan": 6 },
        { "id": "status", "colspan": 6 },
        { "id": "summary", "colspan": 12, "rowspan": 2 },
        { "id": "rating", "colspan": 6 },
        { "id": "authorId", "colspan": 6 }
      ],
      "items": [
        {
          "type": "collapse",
          "title": "Categories",
          "controls": ["categories"]
        }
      ]
    },
    "view": {
      "type": "grid",
      "columns": 12,
      "controls": [
        { "id": "title", "colspan": 8 },
        { "id": "isbn", "colspan": 4 },
        { "id": "publishedYear", "colspan": 6 },
        { "id": "status", "colspan": 6 },
        { "id": "summary", "colspan": 12 },
        { "id": "rating", "colspan": 6 },
        { "id": "author", "colspan": 6 }
      ],
      "items": [
        {
          "type": "group",
          "title": "Categories",
          "controls": ["categories"]
        }
      ]
    },
    "table": {
      "type": "grid",
      "columns": 12,
      "controls": [
        {
          "component": "CreateByIsbn"
        }
      ],
      "items": [
        {
          "type": "table",
          "controls": [
            "title",
            "author",
            "isbn",
            "publishedYear",
            "status"
          ]
        }
      ]
    }
  }
}
