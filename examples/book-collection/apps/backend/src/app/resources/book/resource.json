{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "name": "book",
  "model": "Book",
  "title": "Books",
  "columns": {
    "id": { "idField": true, "hiddenInForm": true },
    "title": { "searchable": true, "filterable": true, "sortable": true },
    "isbn": { "sortable": true },
    "publishedYear": {
      "sortable": true
    },
    "status": {
      "displayKey": "label",
      "enum": "bookStatus",
      "filterable": true,
      "fieldInput": {
        "type": "select",
        "options": {
          "clearable": false,
          "storeValue": true
        }
      }
    },
    "summary": { "fieldInput": { "type": "textarea" }, "hiddenInTable": true },
    "rating": {
      "hiddenInTable": true,
      "fieldInput": {
        "type": "custom",
        "options": {
          "customComponent": "rating"
        }
      }
    },
    "authorId": {
      "hiddenInTable": true,
      "hiddenInView": true,
      "label": "Author",
      "displayKey": "name",
      "fieldInput": {
        "type": "autocomplete",
        "options": {
          "resource": "/author/schemas",
          "labelKey": "name",
          "valueKey": "id",
          "storeValue": true
        }
      }
    },
    "author": {
      "label": "Author",
      "hiddenInTable": false,
      "hiddenInForm": true,
      "filterable": true,
      "sortable": true,
      "searchable": true,
      "displayKey": "name",
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "options": {
          "displayKey": "name"
        }
      }
    },
    "categories": {
      "label": "Categories",
      "hiddenInTable": true,
      "fieldInput": {
        "format": "relation",
        "resource": "../category/resource.json",
        "relationType": "manyToMany",
        "options": {
          "displayKey": "name"
        }
      }
    }
  },
  "include": ["author", "categories"]
}
