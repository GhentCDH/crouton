{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "name": "loan",
  "title": "Loans",
  "columns": {
    "id": {
      "idField": true,
      "hiddenInForm": true
    },
    "loanedAt": {
      "fieldInput": {
        "defaultValue": "$now",
        "type": "date"
      }
    },
    "returnedAt": {
      "required": false
    },
    "requestedPickupAt": {
      "required": false,
      "fieldInput": {
        "type": "dateTime"
      },
      "hiddenInTable": true
    },
    "rentalPeriod": {
      "required": false,
      "label": "Rental period",
      "hiddenInTable": true,
      "fieldInput": {
        "type": "date-range",
        "options": {
          "fromLabel": "From",
          "toLabel": "To"
        }
      }
    },
    "userId": {
      "hiddenInTable": true,
      "hiddenInView": true,
      "label": "User",
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "options": {
          "resource": "/user/schemas",
          "labelKey": "name",
          "valueKey": "id",
          "storeValue": true
        }
      }
    },
    "bookId": {
      "hiddenInTable": true,
      "hiddenInView": true,
      "label": "Book",
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "options": {
          "resource": "/book/schemas",
          "labelKey": "title",
          "valueKey": "id",
          "storeValue": true
        }
      }
    },
    "book": {
      "label": "Book",
      "hiddenInTable": false,
      "hiddenInForm": true,
      "fieldInput": {
        "foreignKey": "bookId",
        "format": "relation",
        "resource": "../book/resource.json",
        "relationType": "manyToOne",
        "options": {
          "displayKey": "title"
        }
      }
    },
    "user": {
      "label": "User",
      "hiddenInTable": false,
      "hiddenInForm": true,
      "fieldInput": {
        "foreignKey": "userId",
        "format": "relation",
        "resource": "../user/resource.json",
        "relationType": "manyToOne",
        "options": {
          "displayKey": "name"
        }
      }
    }
  },
  "operations": {
    "findAll": {
      "include": ["user", "book"]
    },
    "findOne": {
      "include": ["user", "book"]
    }
  },
  "source": {
    "model": "Loan"
  },
  "layout": {
    "form": {
      "items": [
        "loanedAt",
        "userId",
        "bookId",
        "returnedAt",
        "requestedPickupAt",
        "rentalPeriod"
      ]
    },
    "view": {
      "items": [
        "id",
        "book",
        "user",
        "loanedAt",
        "returnedAt",
        "requestedPickupAt",
        "rentalPeriod"
      ]
    },
    "table": {
      "items": ["id", "book", "user", "loanedAt", "returnedAt"],
      "rowClick": "none",
      "pageSizes": [10, 20, 50, 100]
    }
  }
}
