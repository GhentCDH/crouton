{
  "name": "book-collection-backend",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "examples/book-collection/apps/backend/src",
  "root": "examples/book-collection/apps/backend",
  "tags": ["scope:backend", "type:backend"],
  "implicitDependencies": ["crouton-prisma"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "project": "crouton-prisma", "target": "build" }, "prisma:generate"],
      "options": {
        "command": "nodemon",
        "cwd": "examples/book-collection/apps/backend",
        "envFile": "examples/book-collection/.env"
      }
    },
    "db:migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate dev",
        "cwd": "examples/book-collection/apps/backend"
      }
    },
    "db:seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx prisma/seed.ts",
        "cwd": "examples/book-collection/apps/backend"
      }
    },
    "db:reset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate reset --force && tsx prisma/seed.ts",
        "cwd": "examples/book-collection/apps/backend"
      }
    },
    "prisma:generate": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["crouton-prisma"], "target": "build" }],
      "options": {
        "command": "prisma generate",
        "cwd": "examples/book-collection/apps/backend"
      }
    },
    "db:e2e-setup": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma:generate"],
      "options": {
        "command": "rm -f prisma/e2e.db && prisma migrate deploy && tsx prisma/seed.ts",
        "cwd": "examples/book-collection/apps/backend",
        "env": {
          "DATABASE_URL": "file:./e2e.db",
          "PORT": "4444"
        }
      }
    }
  }
}
