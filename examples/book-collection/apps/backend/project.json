{
  "name": "book-collection-backend",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "examples/book-collection/apps/backend/src",
  "root": "examples/book-collection/apps/backend",
  "tags": ["scope:backend"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/examples/book-collection/apps/backend"],
      "options": {
        "commands": ["tsup"],
        "cwd": "examples/book-collection/apps/backend"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx/esm src/main.ts",
        "cwd": "examples/book-collection/apps/backend",
        "envFile": "examples/book-collection/.env"
      }
    },
    "db:migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate dev",
        "cwd": "examples/book-collection/apps/backend"
      }
    },
    "db:seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx prisma/seed.ts",
        "cwd": "examples/book-collection/apps/backend"
      }
    },
    "db:reset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate reset --force && tsx prisma/seed.ts",
        "cwd": "examples/book-collection/apps/backend"
      }
    },
    "prisma:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma generate",
        "cwd": "examples/book-collection/apps/backend"
      }
    }
  }
}
