{
  "name": "crouton-ui-vue",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/crouton-ui-vue/src",
  "tags": ["scope:crouton", "type:ui", "tech:vue", "platform:vue"],
  "// targets": "to see all targets run: nx show project ui --web",
  "targets": {
    "build": {
      "command": "vite build",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "command": "vue-tsc --noEmit -p tsconfig.lib.json",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  }
}
