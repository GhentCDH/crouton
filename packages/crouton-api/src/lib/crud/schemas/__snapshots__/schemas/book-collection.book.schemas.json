  "idType": "string",
  "modalSize": "sm",
  "operations": {
    "findAll": {
      "uri": "http://localhost:3000/book",
      "method": "get"
    },
    "findOne": {
      "uri": "http://localhost:3000/book/{id}",
      "method": "get"
    },
    "create": {
      "uri": "http://localhost:3000/book",
      "method": "post"
    },
    "update": {
      "uri": "http://localhost:3000/book/{id}",
      "method": "put"
    },
    "patch": {
      "uri": "http://localhost:3000/book/{id}",
      "method": "patch"
    },
    "delete": {
      "uri": "http://localhost:3000/book/{id}",
      "method": "delete"
    },
    "lookup": "http://localhost:3000/book?q={text}"
  },
  "display": {
    "mode": "modal",
    "customComponent": null
  },
  "schemas": {
    "table": {
      "data": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "title": "Title",
            "minLength": 1
          },
          "isbn": {
            "type": "string",
            "title": "Isbn",
            "minLength": 1
          },
          "publishedYear": {
            "type": "integer",
            "title": "Published year"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "enum": [
              "draft",
              "published",
              "archived"
            ],
            "minLength": 1
          },
          "authorId": {
            "title": "Author"
          }
        },
        "additionalProperties": true
      },
      "ui": {
        "type": "HorizontalLayout",
        "elements": [
          {
            "type": "TextCell",
            "scope": "#/properties/id",
            "options": {
              "sortable": false,
              "label": "Id"
            }
          },
          {
            "type": "TextCell",
            "scope": "#/properties/title",
            "options": {
              "sortId": "title",
              "label": "Title"
            }
          },
          {
            "type": "TextCell",
            "scope": "#/properties/isbn",
            "options": {
              "sortId": "isbn",
              "label": "Isbn"
            }
          },
          {
            "type": "TextCell",
            "scope": "#/properties/publishedYear",
            "options": {
              "sortId": "publishedYear",
              "label": "Published year"
            }
          },
          {
            "type": "TextCell",
            "scope": "#/properties/status",
            "options": {
              "values": [
                {
                  "value": "draft",
                  "label": "Draft"
                },
                {
                  "value": "published",
                  "label": "Published"
                },
                {
                  "value": "archived",
                  "label": "Archived"
                }
              ],
              "sortable": false,
              "label": "Status"
            }
          },
          {
            "type": "RecordCell",
            "scope": "#/properties/authorId",
            "options": {
              "resourceUri": "http://localhost:3000/author",
              "schemasUri": "http://localhost:3000/author/schemas",
              "sortable": false,
              "relationType": "manyToOne",
              "label": "Author"
            }
          }
        ]
