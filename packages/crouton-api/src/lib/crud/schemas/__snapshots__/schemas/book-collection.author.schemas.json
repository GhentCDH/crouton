{
  "id": "author",
  "name": "author",
  "route": "author",
  "uri": "http://localhost:3000/author",
  "title": "Authors",
  "idField": "id",
  "modalSize": "sm",
  "operations": {
    "findAll": {
      "uri": "http://localhost:3000/author",
      "method": "get"
    },
    "findOne": {
      "uri": "http://localhost:3000/author/{id}",
      "method": "get"
    },
    "create": {
      "uri": "http://localhost:3000/author",
      "method": "post"
    },
    "update": {
      "uri": "http://localhost:3000/author/{id}",
      "method": "put"
    },
    "patch": {
      "uri": "http://localhost:3000/author/{id}",
      "method": "patch"
    },
    "delete": {
      "uri": "http://localhost:3000/author/{id}",
      "method": "delete"
    },
    "lookup": "http://localhost:3000/author?q={text}"
  },
  "display": {
    "mode": "modal",
    "customComponent": null
  },
  "schemas": {
    "table": {
      "data": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "ui": {
        "type": "Table",
        "elements": [
          {
            "type": "TextCell",
            "scope": "#/properties/name",
            "options": {
              "sortId": "name",
              "label": "Name",
              "minWidth": "8rem",
              "maxWidth": "24rem",
              "truncate": true,
              "visible": true
            }
          }
        ],
        "options": {
          "pageSize": 20,
          "pageSizes": [
            20,
            50,
            100
          ],
          "density": "normal",
          "rowClick": "view",
          "defaultSortId": "name",
          "defaultSortDir": "asc",
          "filter": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "title": "Name",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            },
            "uischema": {
              "type": "GridLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/name",
                  "options": {
                    "format": "text",
                    "styles": {
                      "width": "full",
                      "control": {
                        "wrapper": "input-full"
                      }
                    },
                    "colspan": 12,
                    "label": "Name"
                  }
                }
              ]
            },
            "initialData": {}
          }
        }
      }
    },
    "form": {
      "data": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "minLength": 1
          },
          "bio": {
            "type": "string",
            "title": "Bio",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "ui": {
        "type": "GridLayout",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/name",
            "options": {
              "format": "text",
              "styles": {
                "width": "full",
                "control": {
                  "wrapper": "input-full"
                }
              },
              "colspan": 12,
              "label": "Name"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/bio",
            "options": {
              "format": "textarea",
              "styles": {
                "width": "full",
                "control": {
                  "wrapper": "input-full"
                }
              },
              "colspan": 12,
              "label": "Bio"
            }
          }
        ]
      }
    },
    "view": {
      "data": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "title": "Name",
            "minLength": 1
          },
          "bio": {
            "type": "string",
            "title": "Bio",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "ui": {
        "type": "GridLayout",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/id",
            "options": {
              "format": "text",
              "styles": {
                "width": "full",
                "control": {
                  "wrapper": "input-full"
                }
              },
              "colspan": 12,
              "label": "Id"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/name",
            "options": {
              "format": "text",
              "styles": {
                "width": "full",
                "control": {
                  "wrapper": "input-full"
                }
              },
              "colspan": 12,
              "label": "Name"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/bio",
            "options": {
              "format": "textarea",
              "styles": {
                "width": "full",
                "control": {
                  "wrapper": "input-full"
                }
              },
              "colspan": 12,
              "label": "Bio"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/books",
            "options": {
              "format": "relation",
              "styles": {
                "width": "full",
                "control": {
                  "wrapper": "input-full"
                }
              },
              "uri": "http://localhost:3000/author/{id}/book",
              "resourceUri": "http://localhost:3000/book",
              "resource": "http://localhost:3000/author/book/schemas",
              "autocompleteResource": "http://localhost:3000/book/schemas",
              "colspan": 12,
              "relationType": "oneToMany",
              "label": "Books"
            }
          }
        ]
      }
    }
  }
}