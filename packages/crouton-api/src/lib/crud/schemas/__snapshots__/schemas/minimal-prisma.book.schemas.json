{
  "id": "book",
  "name": "book",
  "route": "books",
  "uri": "http://localhost:3000/books",
  "title": "Book",
  "idField": "id",
  "modalSize": "sm",
  "operations": {
    "findAll": {
      "uri": "http://localhost:3000/books",
      "method": "get"
    },
    "findOne": {
      "uri": "http://localhost:3000/books/{id}",
      "method": "get"
    },
    "create": {
      "uri": "http://localhost:3000/books",
      "method": "post"
    },
    "update": {
      "uri": "http://localhost:3000/books/{id}",
      "method": "put"
    },
    "patch": {
      "uri": "http://localhost:3000/books/{id}",
      "method": "patch"
    },
    "delete": {
      "uri": "http://localhost:3000/books/{id}",
      "method": "delete"
    },
    "lookup": "http://localhost:3000/books?q={text}"
  },
  "display": {
    "mode": "modal",
    "customComponent": null
  },
  "schemas": {
    "table": {
      "data": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "ui": {
        "type": "Table",
        "elements": [
          {
            "type": "TextCell",
            "scope": "#/properties/title",
            "options": {
              "sortId": "title",
              "label": "Title"
            }
          }
        ],
        "options": {
          "defaultSortId": "title",
          "defaultSortDir": "asc"
        }
      }
    },
    "form": {
      "data": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "ui": {
        "type": "GridLayout",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/title",
            "options": {
              "format": "text",
              "styles": {
                "width": "full",
                "control": {
                  "wrapper": "input-full"
                }
              },
              "colspan": 12,
              "label": "Title"
            }
          }
        ]
      }
    },
    "view": {
      "data": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "title": "Title",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "ui": {
        "type": "GridLayout",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/id",
            "options": {
              "format": "text",
              "styles": {
                "width": "full",
                "control": {
                  "wrapper": "input-full"
                }
              },
              "colspan": 12,
              "label": "Id"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/title",
            "options": {
              "format": "text",
              "styles": {
                "width": "full",
                "control": {
                  "wrapper": "input-full"
                }
              },
              "colspan": 12,
              "label": "Title"
            }
          }
        ]
      }
    }
  }
}