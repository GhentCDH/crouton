{
  "name": "@ghentcdh/crouton-api",
  "version": "0.0.1-alpha.90",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GhentCDH/crouton",
    "directory": "packages/crouton-api"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "exports": {
    ".": {
      "@ghentcdh/crouton": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "@ghentcdh/crouton": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@crouton/auth": "workspace:*",
    "@crouton/auth-nest": "workspace:*",
    "@crouton/i18n": "workspace:*",
    "@crouton/status": "workspace:*",
    "@ghentcdh/crouton-codegen": "workspace:*",
    "@ghentcdh/crouton-core": "workspace:*",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/supertest": "^7.2.1",
    "prisma": ">=7.0.0",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@nestjs/passport": "^12.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-http-bearer": "^1.0.1",
    "passport-microsoft": "^2.1.0",
    "passport-openidconnect": "^0.1.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/swagger": ">=7.0.0",
    "@prisma/client": ">=7.0.0",
    "@prisma/internals": ">=7.0.0",
    "nestjs-zod": ">=5.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/internals": {
      "optional": true
    }
  }
}
