{
  "name": "@ghentcdh/crouton-api",
  "version": "0.0.1-alpha.79",
  "repository": {
    "type": "git",
    "url": "https://github.com/GhentCDH/crouton",
    "directory": "packages/crouton-api"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@ghentcdh/crouton-codegen": "workspace:*",
    "@ghentcdh/crouton-core": "workspace:*",
    "@nestjs/platform-express": ">=10.0.0",
    "@nestjs/testing": ">=10.0.0",
    "@swc/core": "^1.7.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.0.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "nestjs-zod": ">=5.0.0",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "@nestjs/swagger": ">=7.0.0",
    "@prisma/client": ">=5.0.0",
    "@prisma/internals": ">=5.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/internals": {
      "optional": true
    }
  }
}
