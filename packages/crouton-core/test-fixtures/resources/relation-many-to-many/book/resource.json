{
  "name": "book",
  "model": "Book",
  "route": "books",
  "columns": {
    "id": { "idField": true, "hiddenInForm": true },
    "title": { "searchable": true, "sortable": true },
    "categories": {
      "label": "Categories",
      "fieldInput": {
        "format": "relation",
        "relationType": "manyToMany",
        "resource": "./category.resource"
      },
      "hiddenInTable": true
    }
  },
  "include": ["categories"]
}
