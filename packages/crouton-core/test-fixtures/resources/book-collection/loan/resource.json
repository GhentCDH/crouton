{
  "name": "loan",
  "model": "Loan",
  "title": "Loans",
  "columns": {
    "id": { "idField": true, "hiddenInForm": true },
    "loanedAt": { "type": "string", "sortable": true, "defaultSort": true },
    "returnedAt": { "type": "string", "required": false },
    "userId": {
      "label": "User",
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "./user.resource"
      }
    },
    "bookId": {
      "label": "Book",
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "./book.resource"
      }
    }
  },
  "include": ["user", "book"]
}
