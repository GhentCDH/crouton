{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "label": {
      "description": "Override the field label",
      "type": "string"
    },
    "hideLabel": {
      "description": "Hide the label",
      "type": "boolean"
    },
    "placeholder": {
      "type": "string"
    },
    "readonly": {
      "type": "boolean"
    },
    "colspan": {
      "default": 12,
      "type": "number"
    },
    "width": {
      "type": "string"
    },
    "styles": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "customRender": {
      "type": "string"
    },
    "sort": {
      "description": "Field to sort related records by",
      "type": "string"
    },
    "sortDir": {
      "description": "Sort direction, defaults to asc",
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "direction": {
      "description": "CSS flex direction for the button layout",
      "type": "string"
    },
    "displayKey": {
      "description": "Key used as display label",
      "type": "string"
    },
    "resource": {
      "description": "Path to the related resource",
      "type": "string"
    }
  },
  "additionalProperties": {},
  "$id": "https://ghentcdh.github.io/crouton/schema/v1/relation.field-input.schema.json",
  "title": "Crouton fieldInput options: relation"
}
