{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "label": {
      "description": "Override the field label",
      "examples": [
        "My label"
      ],
      "type": "string"
    },
    "hideLabel": {
      "description": "Hide the field label",
      "type": "boolean"
    },
    "placeholder": {
      "description": "Placeholder text shown inside the input when empty",
      "examples": [
        "Search..."
      ],
      "type": "string"
    },
    "readonly": {
      "description": "Render the field in read-only mode",
      "type": "boolean"
    },
    "colspan": {
      "description": "Grid column span (1–12)",
      "examples": [
        6,
        12
      ],
      "type": "number"
    },
    "width": {
      "description": "Named width (xs, sm, md, lg, xl, full) or any CSS value",
      "examples": [
        "md",
        "240px"
      ],
      "type": "string"
    },
    "styles": {
      "description": "Inline CSS style object applied to the field wrapper",
      "examples": [
        {
          "color": "red"
        }
      ],
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "customRender": {
      "description": "Name of a globally registered Vue component to render instead of the default input",
      "examples": [
        "MyCustomInput"
      ],
      "type": "string"
    },
    "minHeight": {
      "description": "Minimum editor height",
      "examples": [
        "200px",
        "400px"
      ],
      "type": "string"
    }
  },
  "additionalProperties": {},
  "title": "Crouton fieldInput options: markdown",
  "description": "Options for the Markdown rich-text editor",
  "$id": "https://ghentcdh.github.io/crouton/schema/v1/markdown.field-input.schema.json"
}
