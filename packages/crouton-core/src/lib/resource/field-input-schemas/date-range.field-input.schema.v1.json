{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "label": {
      "description": "Override the field label",
      "type": "string"
    },
    "hideLabel": {
      "description": "Hide the label",
      "type": "boolean"
    },
    "placeholder": {
      "type": "string"
    },
    "readonly": {
      "type": "boolean"
    },
    "colspan": {
      "type": "number"
    },
    "width": {
      "type": "string"
    },
    "styles": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "customRender": {
      "type": "string"
    },
    "fromLabel": {
      "description": "Label above the start date input. Defaults to \"From\"",
      "type": "string"
    },
    "toLabel": {
      "description": "Label above the end date input. Defaults to \"To\"",
      "type": "string"
    },
    "fromField": {
      "description": "JSON object key for the start date. Defaults to \"from\"",
      "type": "string"
    },
    "toField": {
      "description": "JSON object key for the end date. Defaults to \"to\"",
      "type": "string"
    }
  },
  "additionalProperties": {},
  "$id": "https://ghentcdh.github.io/crouton/schema/v1/date-range.field-input.schema.json",
  "title": "Crouton fieldInput options: date-range"
}
