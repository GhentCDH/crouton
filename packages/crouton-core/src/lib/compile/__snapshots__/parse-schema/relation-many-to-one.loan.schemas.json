{
  "id": "loan",
  "name": "loan",
  "route": "loans",
  "uri": "http://localhost:3000/loans",
  "title": "Loan",
  "idField": "id",
  "modalSize": "sm",
  "operations": {
    "findAll": {
      "uri": "http://localhost:3000/loans",
      "method": "get"
    },
    "findOne": {
      "uri": "http://localhost:3000/loans/{id}",
      "method": "get"
    },
    "create": {
      "uri": "http://localhost:3000/loans",
      "method": "post"
    },
    "update": {
      "uri": "http://localhost:3000/loans/{id}",
      "method": "put"
    },
    "patch": {
      "uri": "http://localhost:3000/loans/{id}",
      "method": "patch"
    },
    "delete": {
      "uri": "http://localhost:3000/loans/{id}",
      "method": "delete"
    },
    "lookup": "http://localhost:3000/loans?q={text}"
  },
  "display": {
    "mode": "modal",
    "customComponent": null
  },
  "schemas": {
    "table": {
      "data": {
        "type": "object",
        "properties": {
          "loanedAt": {
            "type": "string",
            "title": "Loaned at",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "ui": {
        "type": "Table",
        "elements": [
          {
            "type": "TextCell",
            "scope": "#/properties/loanedAt",
            "options": {
              "sortId": "loanedAt",
              "label": "Loaned at",
              "minWidth": "8rem",
              "maxWidth": "24rem",
              "truncate": true,
              "visible": true
            }
          }
        ],
        "options": {
          "pageSize": 20,
          "pageSizes": [
            20,
            50,
            100
          ],
          "density": "normal",
          "rowClick": "view",
          "defaultSortId": "loanedAt",
          "defaultSortDir": "asc"
        }
      }
    },
    "form": {
      "data": {
        "type": "object",
        "properties": {
          "loanedAt": {
            "type": "string",
            "title": "Loaned at",
            "minLength": 1
          },
          "bookId": {
            "title": "Book"
          }
        },
        "additionalProperties": true
      },
      "ui": {
        "type": "GridLayout",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/loanedAt",
            "options": {
              "format": "text",
              "styles": {
                "width": "full",
                "control": {
                  "wrapper": "input-full"
                }
              },
              "colspan": 12,
              "label": "Loaned at"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/bookId",
            "options": {
              "format": "autocomplete",
              "styles": {
                "width": "full",
                "control": {
                  "wrapper": "input-full"
                }
              },
              "colspan": 12,
              "relationType": "manyToOne",
              "label": "Book"
            }
          }
        ]
      }
    },
    "view": {
      "data": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "minLength": 1
          },
          "loanedAt": {
            "type": "string",
            "title": "Loaned at",
            "minLength": 1
          },
          "bookId": {
            "title": "Book"
          }
        },
        "additionalProperties": true
      },
      "ui": {
        "type": "GridLayout",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/id",
            "options": {
              "format": "text",
              "styles": {
                "width": "full",
                "control": {
                  "wrapper": "input-full"
                }
              },
              "colspan": 12,
              "label": "Id"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/loanedAt",
            "options": {
              "format": "text",
              "styles": {
                "width": "full",
                "control": {
                  "wrapper": "input-full"
                }
              },
              "colspan": 12,
              "label": "Loaned at"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/bookId",
            "options": {
              "format": "autocomplete",
              "styles": {
                "width": "full",
                "control": {
                  "wrapper": "input-full"
                }
              },
              "colspan": 12,
              "relationType": "manyToOne",
              "label": "Book"
            }
          }
        ]
      }
    }
  }
}