{
  "name": "@ghentcdh/crouton-core",
  "version": "0.0.1-alpha.90",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GhentCDH/crouton",
    "directory": "packages/crouton-core"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "exports": {
    ".": {
      "@ghentcdh/crouton": {
        "types": "./dist/index.d.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@ghentcdh/crouton": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "agent-docs"
  ],
  "peerDependencies": {
    "@jsonforms/core": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@crouton/i18n": "workspace:*",
    "tsup": "^9.0.0",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "test": "vitest run"
  }
}
