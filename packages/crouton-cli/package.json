{
  "name": "@ghentcdh/crouton-cli",
  "version": "0.0.1-alpha.89",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "exports": {
    ".": {
      "@ghentcdh/crouton": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./create-datasource": {
      "@ghentcdh/crouton": "./src/create-datasource/index.ts",
      "import": "./dist/create-datasource/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GhentCDH/crouton",
    "directory": "packages/crouton-cli"
  },
  "bin": {
    "crouton": "./dist/index.js"
  },
  "ng-update": {
    "migrations": "./migrations.json"
  },
  "files": [
    "dist",
    "agent-files",
    "migrations.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@nx/devkit": ">=23.0.0"
  },
  "peerDependenciesMeta": {
    "@nx/devkit": {
      "optional": true
    }
  },
  "dependencies": {
    "@prisma/internals": "^7.10.0",
    "prisma-case-format": "^2.2.1"
  },
  "devDependencies": {
    "@nx/devkit": "23.2.1",
    "@clack/prompts": "^1.8.1",
    "@crouton/i18n": "workspace:*",
    "@ghentcdh/crouton-codegen": "workspace:*",
    "@ghentcdh/crouton-core": "workspace:*",
    "commander": "^15.1.0",
    "picocolors": "^1.1.0",
    "tsup": "^9.0.0"
  }
}
