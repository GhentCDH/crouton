{
  "name": "@ghentcdh/crouton-cli",
  "version": "0.2.0-rc.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "exports": {
    ".": {
      "@ghentcdh/crouton": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./create-datasource": {
      "@ghentcdh/crouton": "./src/create-datasource/index.ts",
      "import": "./dist/create-datasource/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GhentCDH/crouton",
    "directory": "packages/crouton-cli"
  },
  "bin": {
    "crouton": "./dist/index.js"
  },
  "files": [
    "dist",
    "agent-files"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/internals": "^7.10.0",
    "prisma-case-format": "^2.2.1"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@crouton/i18n": "workspace:*",
    "@ghentcdh/create-crouton": "workspace:*",
    "@ghentcdh/crouton-codegen": "workspace:*",
    "@ghentcdh/crouton-core": "workspace:*",
    "commander": "^15.1.0",
    "picocolors": "^1.1.0",
    "tsup": "^9.0.0",
    "vitest": "^5.1.0"
  }
}
