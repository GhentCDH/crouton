{
  "name": "crouton-auth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/crouton-auth/src",
  "tags": ["scope:crouton", "type:util", "tech:typescript", "platform:shared"],
  "targets": {
    "build": {
      "dependsOn": ["^build"],
      "command": "pnpm run build",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/dist"]
    },
    "nx-release-publish": {
      "dependsOn": ["build"],
      "command": "npm publish --access public",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  }
}
