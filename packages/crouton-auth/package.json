{
  "name": "@ghentcdh/crouton-auth",
  "version": "0.0.1-alpha.91",
  "repository": {
    "type": "git",
    "url": "https://github.com/GhentCDH/crouton",
    "directory": "packages/crouton-auth"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "exports": {
    ".": {
      "@ghentcdh/crouton": {
        "types": "./dist/index.d.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./auth-provider.schema.json": "./dist/auth-provider.schema.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@crouton/auth": "workspace:*",
    "tsup": "^9.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json"
  }
}
