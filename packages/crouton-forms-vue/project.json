{
  "name": "crouton-forms-vue",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/crouton-forms-vue/src",
  "tags": ["scope:crouton", "type:ui", "tech:vue", "platform:vue"],
  "targets": {
    "typecheck": {
      "command": "vue-tsc --noEmit -p tsconfig.lib.json",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "command": "vitest run --project node",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "test-browser": {
      "command": "vitest run --project browser --coverage",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/coverage"]
    }
  }
}
