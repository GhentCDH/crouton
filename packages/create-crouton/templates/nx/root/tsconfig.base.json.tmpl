{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "baseUrl": ".",
    "paths": {
      "@{{scope}}/generated-default-types": ["./{{generatedTypesPath}}"],
      "@{{scope}}/generated-default-types/*": ["./{{generatedTypesPath}}/*"],
      "@{{scope}}/generated-default-client": ["./{{generatedClientPath}}"],
      "@{{scope}}/generated-default-client/*": ["./{{generatedClientPath}}/*"]
    }
  }
}
