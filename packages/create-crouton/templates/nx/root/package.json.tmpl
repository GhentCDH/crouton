{
  "name": "@{{name}}/workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@{{dep:pnpm}}",
  "engines": {
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "nx run-many -t serve --parallel",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "crouton": "crouton"
  },
  "devDependencies": {
    "@eslint/js": "{{dep:@eslint/js}}",
    "@nx/eslint": "{{dep:@nx/eslint}}",
    "@nx/eslint-plugin": "{{dep:@nx/eslint-plugin}}",
    "@ghentcdh/create-crouton": "{{version}}",
    "@ghentcdh/crouton-cli": "{{version}}",
    "@ghentcdh/crouton-prisma": "{{version}}",
    "@nx/js": "{{dep:@nx/js}}",
    "@prisma/client": "{{dep:@prisma/client}}",
    "@prisma/client-runtime-utils": "{{dep:@prisma/client}}",
    "@swc/core": "{{dep:@swc/core}}",
    "@swc/helpers": "{{dep:@swc/helpers}}",
    "dotenv": "{{dep:dotenv}}",
    "esbuild-plugin-swc": "^1.0.0",
    "eslint": "{{dep:eslint}}",
    "typescript-eslint": "{{dep:typescript-eslint}}",
    "nodemon": "{{dep:nodemon}}",
    "nx": "{{dep:nx}}",
    "prisma": "{{dep:prisma}}",
    "prettier": "{{dep:prettier}}",
    "tsx": "{{dep:tsx}}",
    "tsup": "{{dep:tsup}}",
    "typescript": "{{dep:typescript}}",
    "zod": "{{dep:zod}}",
    "zod-prisma-types": "{{dep:zod-prisma-types}}"
  }
}
