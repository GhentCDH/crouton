packages:
  - {{appsRoot}}/*
  - {{generatedRoot}}/**
  - '!{{generatedRoot}}/*/client'
  - libs/*

allowBuilds:
  '@swc/core': true
  '@prisma/engines': true
  '@scarf/scarf': true
  esbuild: true
  nx: true
  prisma: true

minimumReleaseAge: 0

onlyBuiltDependencies:
  - '@swc/core'
  - '@prisma/engines'
  - '@scarf/scarf'
  - esbuild
  - nx
  - prisma

# nestjs-zod (used by @ghentcdh/crouton-api) has not declared NestJS 12 support yet; it works.
peerDependencyRules:
  allowedVersions:
    nestjs-zod>@nestjs/common: '12'
    nestjs-zod>@nestjs/swagger: '12'
