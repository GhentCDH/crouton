{
  "name": "{{backendApp}}",
  "$schema": "{{backendToRoot}}node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "{{backendRoot}}/src",
  "tags": ["scope:backend"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/{{backendDist}}"],
      "options": {
        "commands": ["tsup"],
        "cwd": "{{backendRoot}}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nodemon",
        "cwd": "{{backendRoot}}",
        "envFile": "{{envFile}}"
      }
    }
  }
}
