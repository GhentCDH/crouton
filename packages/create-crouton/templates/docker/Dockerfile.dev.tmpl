{{#if nx}}# syntax=docker/dockerfile:1.7-labs
FROM node:24-alpine
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@latest --activate
ENV CI=true

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --parents {{appsRoot}}/*/package.json {{generatedGlob}}/*/package.json ./

RUN --mount=type=secret,id=npmrc,target=/app/.npmrc pnpm install

CMD pnpm exec nx run ${NX_COMMAND} --host 0.0.0.0 --port=${PORT}
{{/if}}{{#if regular}}FROM node:24-alpine
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@latest --activate
ENV CI=true
COPY package.json pnpm-lock.yaml ./
RUN --mount=type=secret,id=npmrc,target=/app/.npmrc pnpm install
CMD ["pnpm","dev"]
{{/if}}