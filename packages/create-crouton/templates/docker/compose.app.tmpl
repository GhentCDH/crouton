networks:
  {{network}}-net:
    name: {{network}}-net

services:
{{#if frontend}}  {{appName}}-frontend:
    build:
      context: .
      dockerfile: {{dockerfileDev}}
    env_file: [{{envFile}}]
    ports:
      - "${FRONTEND_PORT:-{{frontendPort}}}:${FRONTEND_PORT:-{{frontendPort}}}"
    environment:
      - BACKEND_HOST={{appName}}-backend
      - NX_COMMAND={{frontendApp}}:dev
      - WATCHPACK_POLLING=true
      - IS_DOCKER=true
    volumes:
      - .:/app
      - /app/node_modules
      - /app/.nx
    networks: [{{network}}-net]
{{/if}}{{#if nx}}  {{appName}}-backend:
    build:
      context: .
      dockerfile: {{dockerfileDev}}
    env_file: [{{envFile}}]
    ports:
      - "${BACKEND_PORT:-{{backendPort}}}:${BACKEND_PORT:-{{backendPort}}}"
    # The Prisma client is git-ignored: generate it before serving (serve even if it fails, errors show on /crouton/status).
    command: sh -c "pnpm exec crouton generate --yes --cwd {{workspaceRoot}}; pnpm exec nx run {{backendApp}}:serve"
    environment:
      - NX_COMMAND={{backendApp}}:serve
      - WATCHPACK_POLLING=true
      - IS_DOCKER=true
    volumes:
      - .:/app
      - /app/node_modules
      - /app/.nx
    networks: [{{network}}-net]
{{/if}}{{#if regular}}  {{appName}}-backend:
    build:
      context: .
      dockerfile: {{dockerfileDev}}
    env_file: [{{envFile}}]
    ports:
      - "{{backendPort}}:{{backendPort}}"
    # The Prisma client is git-ignored: generate it before serving (serve even if it fails, errors show on /crouton/status).
    command: sh -c "pnpm exec crouton generate --yes; pnpm dev"
    environment:
      - PORT={{backendPort}}
    volumes:
      - .:/app
      - /app/node_modules
    networks: [{{network}}-net]
{{/if}}