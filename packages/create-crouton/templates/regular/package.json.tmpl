{
  "name": "{{name}}",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "prisma:migrate": "npx prisma migrate dev --config prisma/default/prisma.config.ts",
    "crouton": "crouton"
  },
  "dependencies": {
    "@ghentcdh/crouton-api": "{{version}}",
    "@nestjs/common": "{{dep:@nestjs/common}}",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "{{dep:@nestjs/core}}",
    "@nestjs/platform-express": "{{dep:@nestjs/platform-express}}",
    "@nestjs/swagger": "{{dep:@nestjs/swagger}}",
    "@prisma/adapter-pg": "{{dep:@prisma/client}}",
    "@prisma/client": "{{dep:@prisma/client}}",
    "dotenv": "{{dep:dotenv}}",
    "reflect-metadata": "{{dep:reflect-metadata}}",
    "rxjs": "{{dep:rxjs}}",
    "tslib": "{{dep:tslib}}",
    "zod": "{{dep:zod}}"
  },
  "devDependencies": {
    "@ghentcdh/crouton-cli": "{{version}}",
    "@ghentcdh/crouton-prisma": "{{version}}",
    "@nestjs/cli": "^12.0.15",
    "@types/node": "{{dep:@types/node}}",
    "prisma": "{{dep:prisma}}",
    "typescript": "{{dep:typescript}}",
    "zod-prisma-types": "{{dep:zod-prisma-types}}"
  }
}
