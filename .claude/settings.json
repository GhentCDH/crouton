{
  "permissions": {
    "deny": [
      "Read(./.nx/cache/**)",
      "Read(./.nx/workspace-data/**)",
      "Read(./dist/**)",
      "Read(./tmp/**)",
      "Read(./node_modules/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "enabledPlugins": {
    "nx@nx-claude-plugins": true
  },
  "sandbox": {
    "filesystem": {
      "allowRead": ["/tmp/.nx", "~/.nx"],
      "allowWrite": ["/tmp/.nx", "~/.nx"]
    },
    "network": {
      "allowUnixSockets": ["/tmp/.nx", "~/.nx"]
    }
  }
}
